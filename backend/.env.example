# =====================================================================
# SMART FLEET - ENVIRONMENT VARIABLES TEMPLATE
# =====================================================================
# INSTRUCTIONS FOR TEAMMATES:
# 1. Copy this file and rename the copy to `.env` (or `.env.development`)
# 2. Fill in your own values below.
# 3. NEVER commit your actual .env file to Git!
# =====================================================================

# The environment your app is running in (development, production, test)
NODE_ENV=development

# The port the backend server will run on
PORT=5000

# =====================================================================
# MONGODB CONNECTION STRING
# =====================================================================
# 1. Log into MongoDB Atlas (cloud.mongodb.com)
# 2. Go to Database -> Connect -> Drivers -> Node.js
# 3. Copy the connection string and replace <password> with your DB user password.
# 4. Make sure to add the database name (e.g., smart_fleet_dev) before the '?'
# Example format:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/smart_fleet_dev?retryWrites=true&w=majority
MONGODB_URI=

# =====================================================================
# SECURITY & AUTHENTICATION
# =====================================================================
# Secret key used to sign JWT tokens. Use a long random string for production.
JWT_SECRET=super_secret_dev_key_change_me_later

# How long a user's login session lasts before they must log in again
JWT_EXPIRES_IN=1d

# =====================================================================
# CORS (FRONTEND CONNECTIONS)
# =====================================================================
# The URL of your React frontend so the backend allows it to make requests
CORS_ORIGIN=http://localhost:5173