# =====================================================================
# ADMIN WEB - ENVIRONMENT SETUP
# =====================================================================
# 1. Copy this file and rename the copy to ".env" inside admin-web/
#    (Do NOT commit ".env" — it is ignored by Git)
# 2. Keep VITE_USE_MOCK=false to connect to the real backend database.
#    If omitted or set to true, pages will show dummy/sample data only.
# 3. After any change to ".env", stop and restart Vite (npm run dev).
# =====================================================================

# Backend REST API base URL
VITE_API_URL=http://localhost:5000/api
VITE_API_BASE_URL=http://localhost:5000/api

# Backend WebSocket (Socket.IO) server URL for real-time notifications
VITE_SOCKET_URL=http://localhost:5000

# Data source switch:
#   false = use real backend API (default for development & testing)
#   true  = use local mock/dummy data (frontend-only testing)
VITE_USE_MOCK=false